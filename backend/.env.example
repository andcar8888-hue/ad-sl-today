# ---------------------------------------------------------------------------
# AD SL Today — Backend environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/ad-sl-today

# JWT auth
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Manual bank-transfer payment details shown on the Checkout page.
# There is NO real payment gateway integration — the user transfers money
# manually and sends the receipt + userCode via WhatsApp.
ADMIN_WHATSAPP_NUMBER=+94700000000
BANK_ACCOUNT_NUMBER=0000000000
BANK_ACCOUNT_NAME=AD SL Today (Pvt) Ltd
BANK_NAME=Sample Bank PLC
BANK_BRANCH=Colombo Main Branch

# Local image uploads (multer). See backend/README.md for the storage
# decision. Files are served statically from this path.
UPLOAD_DIR=uploads
MAX_UPLOAD_FILES=6
MAX_UPLOAD_FILE_SIZE_MB=5

# CORS — comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173
