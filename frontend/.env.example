# ---------------------------------------------------------------------------
# AD SL Today — Frontend environment variables
# Copy this file to `.env` and adjust if the backend runs elsewhere.
# ---------------------------------------------------------------------------

# Base URL for all API calls (already includes the /api/v1 prefix).
VITE_API_BASE_URL=http://localhost:5001/api/v1

# Server origin (no /api/v1) — used to prefix relative ad image paths
# returned by the backend, e.g. "/uploads/ads/<file>.jpg".
VITE_SERVER_ORIGIN=http://localhost:5001
